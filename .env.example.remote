# Пример конфигурации для удаленного подключения к Ollama
# Скопируйте этот файл в .env и настройте под вашу сеть

# Токен Telegram бота (обязательно)
BOT_TOKEN=ваш_токен_бота

# Провайдер AI (ollama для удаленного подключения)
AI_PROVIDER=ollama

# Настройки Ollama - удаленный сервер
# Замените 192.168.1.100 на реальный IP-адрес вашего компьютера с Ollama
OLLAMA_BASE_URL=http://192.168.1.100:11434
OLLAMA_MODEL=llama3.1

# Путь к базе данных (на ноутбуке)
DB_PATH=data/bot.db

# Интервалы (можно оставить по умолчанию)
# REMINDER_INTERVAL=7200
# SCHEDULE_CHECK_INTERVAL=60

# ============================================
# ИНСТРУКЦИЯ ПО НАСТРОЙКЕ:
# ============================================
# 
# 1. НА КОМПЬЮТЕРЕ (где запущен Ollama):
#    - Установите переменную окружения: OLLAMA_HOST=0.0.0.0:11434
#    - Запустите Ollama: ollama serve
#    - Установите модель: ollama pull llama3.1
#    - Откройте порт 11434 в файрволе
#    - Узнайте IP-адрес компьютера (ipconfig на Windows, ifconfig на Linux)
#
# 2. НА НОУТБУКЕ (где запущен бот):
#    - Скопируйте этот файл в .env
#    - Замените 192.168.1.100 на IP-адрес компьютера
#    - Запустите бота: python bot.py
#
# Подробная инструкция: см. REMOTE_OLLAMA_SETUP.md
